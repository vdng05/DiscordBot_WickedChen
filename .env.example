# ==========================================
# CẤU HÌNH CLAN DISCORD BOT (PYTHON)
# Copy file này thành .env và điền Token của bạn
# ==========================================

# Token xác thực Bot Discord (Lấy tại https://discord.com/developers/applications)
DISCORD_TOKEN=your_bot_token_here

# Tiền tố lệnh Text Prefix (nếu dùng)
COMMAND_PREFIX=!

# ID người quản trị tối cao (User ID của bạn trên Discord)
OWNER_IDS=your_discord_user_id

# Tự động đăng ký / đồng bộ Slash Commands khi bot khởi động (Mặc định: true)
SYNC_ON_STARTUP=true

# Múi giờ hoạt động mặc định (Asia/Ho_Chi_Minh cho giờ Việt Nam)
TIMEZONE=Asia/Ho_Chi_Minh

# Thời gian chờ mặc định sau khi rời / bị trục xuất khỏi băng (giờ)
DEFAULT_LEAVE_COOLDOWN_HOURS=24

# Mức độ log hiển thị (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
